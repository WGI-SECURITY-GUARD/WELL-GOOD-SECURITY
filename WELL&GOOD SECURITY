<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0a2a5e">
<title>WGI ตรวจเช็คกำลังพล</title>

<style>

  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}

  html,body{margin:0;padding:0;width:100%;min-height:100%}

  body{
    position:relative;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans Thai",
                "Sukhumvit Set",Arial,sans-serif;
    color:#0a356f;
    background:#eef2f8;
    overflow-x:hidden;
  }

  /* ---------- พื้นหลัง ---------- */

  .bg{position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;overflow:hidden;background:#eef2f8}

  .bg-navy{
    position:absolute;left:0;right:0;top:0;height:620px;
    background:linear-gradient(160deg,#0a2a5e 0%,#123a76 48%,#0d3164 100%);
    clip-path:polygon(0 0,100% 0,100% 86%,0 100%);
  }

  .bg-dark{
    position:absolute;left:-14%;top:-18%;width:52%;height:95%;
    background:linear-gradient(180deg,#071f47,#0a2a5e);
    transform:rotate(18deg);
    opacity:.85;
  }

  .bg-light{
    position:absolute;right:-18%;top:-22%;width:58%;height:105%;
    background:linear-gradient(200deg,rgba(255,255,255,.10),rgba(255,255,255,0));
    transform:rotate(18deg);
  }

  .bg-line{
    position:absolute;right:-6%;top:-10%;width:1px;height:78%;
    background:rgba(255,255,255,.16);
    transform:rotate(18deg);
  }

  .gold{position:absolute;background:#e8b430;border-radius:2px}
  .gold-1{width:3px;height:230px;left:9%;top:-30px;transform:rotate(18deg)}
  .gold-2{width:3px;height:120px;right:8%;top:58%;transform:rotate(18deg);opacity:.9}

  /* ---------- โครงหน้า ---------- */

  .page{position:relative;z-index:1;min-height:100vh;padding-bottom:40px}

  .hero{
    padding:max(30px,env(safe-area-inset-top)) 20px 30px;
    text-align:center;
    display:flex;flex-direction:column;align-items:center;
  }

  .logo{
    width:150px;height:150px;object-fit:contain;display:block;
    filter:drop-shadow(0 12px 20px rgba(0,0,0,.28));
  }

  .brand{
    color:#fff;font-size:42px;font-weight:800;letter-spacing:5px;
    line-height:1;margin-top:12px;
  }

  .brand-sub{
    color:rgba(255,255,255,.9);font-size:13px;letter-spacing:5px;
    font-weight:500;margin-top:13px;
  }

  .gold-divider{
    width:104px;height:3px;background:#e8b430;border-radius:3px;margin-top:20px;
  }

  /* ---------- การ์ด ---------- */

  .main{width:100%;max-width:560px;margin:26px auto 0;padding:0 20px}

  .card{
    background:#fbfcfe;
    border-radius:26px;
    padding:26px 22px 28px;
    text-align:center;
    box-shadow:0 22px 50px rgba(6,28,62,.28);
  }

  .badge{
    display:inline-flex;align-items:center;gap:9px;
    background:#e9f1fb;color:#123f78;
    border-radius:30px;padding:11px 22px;
    font-size:16px;font-weight:700;letter-spacing:.6px;
    max-width:100%;
  }
  .badge svg{width:19px;height:19px;display:block;flex:none}
  .badge span{white-space:normal}

  .pin-circle{
    width:104px;height:104px;margin:24px auto 18px;border-radius:50%;
    background:linear-gradient(150deg,#eef6ff,#dfeaff);
    display:flex;align-items:center;justify-content:center;
  }
  .pin-circle svg{width:56px;height:56px}

  .title{margin:0;font-size:31px;font-weight:800;color:#0b3a74;line-height:1.35}

  .description{
    margin:10px auto 22px;max-width:430px;
    color:#6b7a8d;font-size:16px;line-height:1.85;font-weight:400;
  }

  /* ---------- ปุ่ม ---------- */

  .gps-button{
    width:100%;min-height:68px;border:0;border-radius:16px;
    background:linear-gradient(100deg,#0a3572 0%,#155397 100%);
    color:#fff;font-family:inherit;font-size:19px;font-weight:700;
    display:flex;align-items:center;justify-content:center;gap:16px;
    cursor:pointer;
    box-shadow:0 12px 24px rgba(10,53,114,.3);
    transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease;
  }
  .gps-button:active{transform:scale(.985);box-shadow:0 6px 14px rgba(10,53,114,.24)}
  .gps-button:focus-visible{outline:3px solid #e8b430;outline-offset:3px}
  .gps-button[disabled]{cursor:default;opacity:.8}

  .btn-icon{width:24px;height:24px;display:block;flex:none}
  .btn-divider{width:1px;height:30px;background:rgba(255,255,255,.45);flex:none}
  .btn-arrow{width:24px;height:24px;display:block;flex:none;margin-left:2px}

  .spin{animation:spin 1s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  @media (prefers-reduced-motion:reduce){.spin{animation:none}}

  /* ---------- สถานะ ---------- */

  .status{
    display:none;margin-top:16px;padding:13px 15px;border-radius:13px;
    font-size:14px;line-height:1.65;text-align:center;
  }
  .status.show{display:block}
  .status.loading{background:#edf5ff;color:#16518e}
  .status.success{background:#ecf9f2;color:#177043}
  .status.error{background:#fff1f1;color:#b42318}

  .link-form{
    display:none;margin-top:14px;width:100%;min-height:54px;
    align-items:center;justify-content:center;
    border-radius:14px;background:#177043;color:#fff;
    font-size:17px;font-weight:700;text-decoration:none;
  }
  .link-form.show{display:flex}

  /* ---------- ฟีเจอร์ ---------- */

  .features{
    display:grid;grid-template-columns:repeat(3,1fr);
    margin-top:34px;
  }
  .feature{position:relative;text-align:center;padding:0 10px}
  .feature:not(:last-child)::after{
    content:"";position:absolute;right:0;top:4px;width:1px;height:66px;background:#d3dde9;
  }
  .feature-icon{
    height:42px;display:flex;align-items:center;justify-content:center;
    color:#0b3d78;margin-bottom:8px;
  }
  .feature-icon svg{width:31px;height:31px}
  .feature-title{color:#153f70;font-size:12.5px;line-height:1.55;font-weight:600}

  /* ---------- ท้ายหน้า ---------- */

  .footer{text-align:center;margin-top:52px;padding:0 20px 16px}
  .footer-line{
    width:230px;max-width:62%;height:1px;margin:0 auto 16px;
    background:linear-gradient(90deg,transparent,#d9b83f,transparent);
  }
  .footer-main{color:#2b4e7c;font-size:15px;line-height:1.7;font-weight:500}
  .footer-sub{color:#2b4e7c;font-size:16px;letter-spacing:.5px;margin-top:2px}

  /* ---------- โหลด / ไม่พบ ---------- */

  .center-box{
    max-width:420px;margin:80px auto 0;background:#fff;border-radius:22px;
    padding:38px 26px;text-align:center;box-shadow:0 16px 40px rgba(9,44,88,.12);
  }
  .center-box h2{color:#0b3675;margin:0 0 10px;font-size:21px}
  .center-box p{color:#6b7280;line-height:1.8;margin:0;font-size:15px}
  .center-ic{width:54px;height:54px;margin:0 auto 16px;color:#b42318}
  .center-ic.loading{color:#16518e}
  .center-ic svg{width:100%;height:100%}

  /* ---------- มือถือ ---------- */

  @media (max-width:600px){
    .bg-navy{height:560px}
    .logo{width:132px;height:132px}
    .brand{font-size:34px;letter-spacing:4px}
    .brand-sub{font-size:11px;letter-spacing:4px}
    .main{padding:0 16px;margin-top:20px}
    .card{border-radius:22px;padding:22px 18px 24px}
    .badge{font-size:15px;padding:10px 18px}
    .pin-circle{width:92px;height:92px;margin:20px auto 16px}
    .pin-circle svg{width:50px;height:50px}
    .title{font-size:27px}
    .description{font-size:14.5px;margin-bottom:18px}
    .gps-button{min-height:62px;font-size:17px;gap:13px}
    .feature-title{font-size:11px}
    .footer{margin-top:44px}
    .footer-main{font-size:13.5px}
    .footer-sub{font-size:15px}
  }

  @media (max-width:380px){
    .logo{width:112px;height:112px}
    .brand{font-size:30px}
    .title{font-size:24px}
    .description{font-size:13.5px}
    .gps-button{min-height:58px;font-size:16px}
  }

</style>
</head>

<body>

  <div class="bg" aria-hidden="true">
    <div class="bg-navy">
      <div class="bg-dark"></div>
      <div class="bg-light"></div>
      <div class="bg-line"></div>
      <div class="gold gold-1"></div>
      <div class="gold gold-2"></div>
    </div>
  </div>

  <div class="page" id="app">
    <!-- เนื้อหาสร้างด้วย JavaScript -->
  </div>


<script>

  /* =========================================================
     ตั้งค่าหลัก — แก้ตรงนี้จุดเดียว
  ========================================================= */

  // ลิงก์ /exec ของไฟล์ Apps Script "WGI_API_only.gs" ที่ Deploy ไว้
  const API_URL = "https://script.google.com/macros/s/https://script.google.com/macros/s/AKfycbx5rtSAOmY4STuxzqVMHSjE8Khhux__9TiggaoFuY3COca203juY4_RFb-nc6VA3Qv62A/exec/exec";

  const FORM_URL =
    "https://docs.google.com/forms/d/e/1FAIpQLScxqJnCDJY-ld73RyEqCKexbDdDrMf6xYLVBvlfgZo3YJXyUw/viewform?usp=header";

  const LOGO_URL =
    "https://drive.google.com/thumbnail?id=1w_sKxYO2r6ChCnCnntZvVnD6yzb_XB3l&sz=w800";

  const USE_ACCURACY_TOLERANCE = true;


  /* =========================================================
     ไอคอน SVG
  ========================================================= */

  const ICON = {

    building:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M3 21h18"/><path d="M5 21V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v16"/>' +
      '<path d="M13 9h5a1 1 0 0 1 1 1v11"/>' +
      '<path d="M8 8h2M8 12h2M8 16h2M16 12h1M16 16h1"/></svg>',

    pinSolid:
      '<svg viewBox="0 0 24 24" fill="currentColor">' +
      '<path d="M12 2.2c-3.9 0-7 3.1-7 7 0 5 6.1 12 6.4 12.3.3.4.9.4 1.2 0 .3-.3 6.4-7.3 6.4-12.3 0-3.9-3.1-7-7-7zm0 9.7a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4z"/></svg>',

    pinRipple:
      '<svg viewBox="0 0 64 64" fill="none">' +
      '<ellipse cx="32" cy="50" rx="17" ry="5.5" stroke="#0b3d78" stroke-width="2.2" opacity=".35"/>' +
      '<ellipse cx="32" cy="50" rx="9"  ry="3"   stroke="#0b3d78" stroke-width="2.2" opacity=".6"/>' +
      '<path fill="#0b3d78" d="M32 5c-8.3 0-15 6.7-15 15 0 10.6 13.1 25.2 13.7 25.8a1.8 1.8 0 0 0 2.6 0C33.9 45.2 47 30.6 47 20c0-8.3-6.7-15-15-15zm0 20.7a5.9 5.9 0 1 1 0-11.8 5.9 5.9 0 0 1 0 11.8z"/></svg>',

    shield:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M12 2.8 19 5.6v5.6c0 4.6-3 8.5-7 9.9-4-1.4-7-5.3-7-9.9V5.6l7-2.8z"/>' +
      '<path d="m8.8 11.9 2.2 2.2 4.2-4.3"/></svg>',

    check:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
      '<circle cx="12" cy="12" r="9"/><path d="m8.3 12.2 2.6 2.6 4.8-5"/></svg>',

    arrow:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg>',

    spinner:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
      '<path d="M12 3a9 9 0 1 0 9 9" /></svg>',

    warning:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M10.3 3.9 1.9 18a2 2 0 0 0 1.7 3h16.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>' +
      '<path d="M12 9v4"/><path d="M12 17h.01"/></svg>'
  };


  /* =========================================================
     เริ่มทำงาน: อ่าน ?company= แล้วยิง fetch ไปหาข้อมูล
  ========================================================= */

  const app = document.getElementById("app");
  const params = new URLSearchParams(window.location.search);
  const companyCode = (params.get("company") || "").toUpperCase();

  showLoading();

  if (!companyCode) {
    showError("ไม่พบหน่วยงาน", "ลิงก์นี้ไม่ได้ระบุรหัสจุดปฏิบัติงาน (company) ตรวจสอบ QR Code อีกครั้ง");
  } else {
    fetch(API_URL + "?company=" + encodeURIComponent(companyCode))
      .then(function(res){ return res.json(); })
      .then(function(data){

        if (!data.success || !data.company) {
          showError("ไม่พบหน่วยงาน", "ตรวจสอบ QR Code หรือลิงก์ของหน่วยงานอีกครั้ง แล้วเปิดใหม่");
          return;
        }

        renderMainPage(data.company);
      })
      .catch(function(err){
        showError("โหลดข้อมูลไม่สำเร็จ", "ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต แล้วลองเปิดหน้านี้ใหม่อีกครั้ง");
        console.error(err);
      });
  }


  function showLoading(){
    document.title = "WGI ตรวจเช็คกำลังพล";
    app.innerHTML =
      '<div class="center-box">' +
        '<div class="center-ic loading">' + ICON.spinner.replace("<svg ", '<svg class="spin" ') + '</div>' +
        '<h2>กำลังโหลดข้อมูล</h2>' +
        '<p>รอสักครู่</p>' +
      '</div>';
  }

  function showError(title, detail){
    document.title = "WGI ตรวจเช็คกำลังพล";
    app.innerHTML =
      '<div class="center-box">' +
        '<div class="center-ic">' + ICON.warning + '</div>' +
        '<h2>' + title + '</h2>' +
        '<p>' + detail + '</p>' +
      '</div>';
  }


  /* =========================================================
     วาดหน้าเว็บหลัก
  ========================================================= */

  function renderMainPage(company){

    document.title = "WGI ตรวจเช็คกำลังพล - " + company.name;

    app.innerHTML = `
      <header class="hero">
        <img src="${LOGO_URL}" class="logo" alt="WGI 2009">
        <div class="brand">WGI</div>
        <div class="brand-sub">SECURITY WELL &amp; GOOD</div>
        <div class="gold-divider"></div>
      </header>

      <main class="main">

        <section class="card">

          <div class="badge">
            ${ICON.building}
            <span>${company.name}</span>
          </div>

          <div class="pin-circle">
            ${ICON.pinRipple}
          </div>

          <h1 class="title">ตรวจสอบพิกัด</h1>

          <p class="description">
            กดปุ่มด้านล่างเพื่อยืนยันตำแหน่งของคุณ<br>
            ก่อนเข้าใช้งานแบบฟอร์ม
          </p>

          <button id="gpsButton" class="gps-button" type="button">
            <span class="btn-icon">${ICON.pinSolid}</span>
            <span class="btn-divider"></span>
            <span>ตรวจสอบพิกัด</span>
            <span class="btn-arrow">${ICON.arrow}</span>
          </button>

          <div id="status" class="status"></div>

          <a id="formLink" class="link-form" href="#">เปิดแบบฟอร์ม</a>

        </section>

        <div class="features">

          <div class="feature">
            <div class="feature-icon">${ICON.shield}</div>
            <div class="feature-title">ระบบรักษาความ<br>ปลอดภัย</div>
          </div>

          <div class="feature">
            <div class="feature-icon">${ICON.pinSolid}</div>
            <div class="feature-title">ตรวจสอบพื้นที่</div>
          </div>

          <div class="feature">
            <div class="feature-icon">${ICON.check}</div>
            <div class="feature-title">ยืนยันตำแหน่ง</div>
          </div>

        </div>

        <footer class="footer">
          <div class="footer-line"></div>
          <div class="footer-main">ระบบตรวจสอบพื้นที่ปฏิบัติงาน</div>
          <div class="footer-sub">WGI 2009</div>
        </footer>

      </main>`;

    setupGpsButton(company);
  }


  /* =========================================================
     ตรรกะ GPS
  ========================================================= */

  function setupGpsButton(company){

    const button   = document.getElementById("gpsButton");
    const statusEl = document.getElementById("status");
    const formLink = document.getElementById("formLink");

    button.addEventListener("click", checkLocation);

    function showStatus(message, type){
      statusEl.innerHTML = message;
      statusEl.className = "status show " + type;
    }

    function setButton(html, disabled){
      button.innerHTML = html;
      button.disabled  = !!disabled;
    }

    function defaultButton(){
      setButton(
        '<span class="btn-icon">' + ICON.pinSolid + '</span>' +
        '<span class="btn-divider"></span>' +
        '<span>ตรวจสอบพิกัด</span>' +
        '<span class="btn-arrow">' + ICON.arrow + '</span>',
        false
      );
    }

    function calculateDistance(lat1, lon1, lat2, lon2){
      const R = 6371000;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;

      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI/180) *
                Math.cos(lat2 * Math.PI/180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);

      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    function checkLocation(){

      if (!navigator.geolocation){
        showStatus("อุปกรณ์นี้ไม่รองรับการระบุตำแหน่ง GPS", "error");
        return;
      }

      setButton(
        '<span class="btn-icon spin">' + ICON.spinner + '</span>' +
        '<span>กำลังตรวจสอบตำแหน่ง...</span>',
        true
      );

      showStatus("กำลังค้นหาตำแหน่งของคุณ รอสักครู่", "loading");

      navigator.geolocation.getCurrentPosition(

        function(position){

          const userLat  = position.coords.latitude;
          const userLng  = position.coords.longitude;
          const accuracy = position.coords.accuracy;

          const distance  = calculateDistance(userLat, userLng, company.lat, company.lng);
          const effective = USE_ACCURACY_TOLERANCE ? Math.max(0, distance - accuracy) : distance;

          console.log("lat", userLat, "lng", userLng, "distance", distance, "accuracy", accuracy);

          if (effective <= company.radius){

            showStatus("ยืนยันตำแหน่งสำเร็จ<br>กำลังเปิดแบบฟอร์ม", "success");

            setButton(
              '<span class="btn-icon">' + ICON.check + '</span>' +
              '<span>ยืนยันตำแหน่งสำเร็จ</span>',
              true
            );

            formLink.href = FORM_URL;
            formLink.classList.add("show");

            window.location.href = FORM_URL;

          } else {

            showStatus(
              "ยังอยู่นอกพื้นที่ปฏิบัติงาน<br>" +
              "ระยะห่าง " + Math.round(distance) + " เมตร " +
              "(ความแม่นยำ GPS ±" + Math.round(accuracy) + " เมตร)<br>" +
              "เข้าใกล้จุดปฏิบัติงานแล้วกดตรวจสอบอีกครั้ง",
              "error"
            );

            defaultButton();
          }
        },

        function(error){

          let message = "ตรวจสอบตำแหน่งไม่สำเร็จ กดลองใหม่อีกครั้ง";

          if (error.code === error.PERMISSION_DENIED){
            message = "เบราว์เซอร์ยังไม่ได้รับอนุญาตให้เข้าถึงตำแหน่ง<br>" +
                      "เปิดสิทธิ์ตำแหน่งในการตั้งค่าเบราว์เซอร์ แล้วกดตรวจสอบอีกครั้ง";
          } else if (error.code === error.POSITION_UNAVAILABLE){
            message = "ค้นหาสัญญาณ GPS ไม่พบ<br>เปิด GPS แล้วลองใหม่";
          } else if (error.code === error.TIMEOUT){
            message = "ค้นหาตำแหน่งนานเกินไป<br>ออกไปที่โล่ง ๆ แล้วกดลองใหม่";
          }

          showStatus(message, "error");
          defaultButton();
        },

        { enableHighAccuracy:true, timeout:20000, maximumAge:0 }
      );
    }
